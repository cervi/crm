# Conexión a PostgreSQL (por defecto, la de `npm run db:dev`)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Zona horaria para mostrar fechas y para las fechas que se introducen
TZ=Europe/Madrid

# Código para crear el primer administrador en /setup (en producción)
SETUP_CODE=

# Claves para la API de entrada de leads (/api/v1/leads), separadas por comas, mínimo 16 caracteres
INBOUND_API_KEYS=

# Cada cuántos minutos revisa la IA los deals (0 = no revisar sola)
AUTOMATIONS_INTERVAL_MINUTES=15

# Secreto para lanzar la revisión desde un cron externo (Vercel Cron…):
# POST /api/v1/automations/run con «Authorization: Bearer <secreto>». Mínimo 16 caracteres.
CRON_SECRET=

# Opcional: cuentas de Microsoft 365 y/o Google Workspace (correo, calendario y documentos).
# Ver Ajustes → Correo, calendario y documentos.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dirección pública del CRM (la vuelta del inicio de sesión es APP_URL/api/integrations/<microsoft|google>/callback)
APP_URL=
# Clave para cifrar los accesos guardados en la base de datos (aleatoria, 32 caracteres o más)
TOKEN_ENCRYPTION_KEY=
